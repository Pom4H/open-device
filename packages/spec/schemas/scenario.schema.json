{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Pom4H/open-device/main/packages/spec/schemas/scenario.schema.json",
  "title": "Open Device scenario",
  "description": "Pre-alpha schema for portable conformance scenarios. Steps are pure data; a runner owns execution mechanics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenarioVersion", "id", "title", "target", "steps"],
  "properties": {
    "scenarioVersion": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
      "maxLength": 128
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "target": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
      "maxLength": 128
    },
    "reset": {
      "enum": ["cold", "warm"]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "portId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "quality": {
      "enum": ["good", "stale", "bad", "unknown"]
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["write"],
          "properties": {
            "write": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/portId"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value"],
                "properties": {
                  "value": {
                    "type": ["number", "boolean"]
                  },
                  "quality": {
                    "$ref": "#/$defs/quality"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tick"],
          "properties": {
            "tick": {
              "type": "object",
              "additionalProperties": false,
              "required": ["durationMs", "periodMs"],
              "properties": {
                "durationMs": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "periodMs": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["expect"],
          "properties": {
            "expect": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/portId"
              },
              "additionalProperties": {
                "$ref": "#/$defs/comparator"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reset"],
          "properties": {
            "reset": {
              "enum": ["cold", "warm"]
            }
          }
        }
      ]
    },
    "comparator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["equals"],
          "properties": {
            "equals": {
              "type": ["number", "boolean"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["approx"],
          "properties": {
            "approx": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "tolerance"],
              "properties": {
                "value": {
                  "type": "number"
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["quality"],
          "properties": {
            "quality": {
              "$ref": "#/$defs/quality"
            }
          }
        }
      ]
    }
  }
}
