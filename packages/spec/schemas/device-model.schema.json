{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Pom4H/open-device/main/packages/spec/schemas/device-model.schema.json",
  "title": "Open Device model document",
  "description": "Pre-alpha schema for the declarative device model referenced by open-device.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["modelVersion", "ports"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "modelVersion": {
      "const": "0.1"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/port"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "faceplate": {
      "$ref": "#/$defs/faceplate"
    }
  },
  "$defs": {
    "portId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "direction", "domain"],
      "properties": {
        "id": {
          "$ref": "#/$defs/portId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "direction": {
          "enum": ["input", "output", "bidirectional"]
        },
        "domain": {
          "enum": ["signal", "power", "network", "process"]
        },
        "signal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dataType"],
          "properties": {
            "dataType": {
              "enum": ["number", "boolean", "integer", "string", "enum"]
            },
            "unit": {
              "type": "string",
              "maxLength": 64
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "physical": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "medium": {
              "type": "string",
              "maxLength": 64
            },
            "kind": {
              "type": "string",
              "maxLength": 64
            },
            "range": {
              "type": "string",
              "maxLength": 64
            }
          }
        },
        "terminals": {
          "type": "array",
          "minItems": 1,
          "description": "Physical connection points owned by this port. Terminal placement is typed (strip + index), so geometry is derived deterministically and stays reusable across renderers.",
          "items": {
            "$ref": "#/$defs/terminal"
          }
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "strip", "index"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "strip": {
          "$ref": "#/$defs/portId"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "millimeters": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "bindReference": {
      "type": "string",
      "description": "Data anchor: 'port:<portId>' binds to a model port value; 'state:<name>' binds to a host-provided device state such as power, link, or status.",
      "pattern": "^(port|state):[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "faceplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "enclosure"],
      "description": "Declarative physical packaging. A conforming compiler turns this block into the front-panel SVG with terminal and mounting anchors; it never requires vendor-drawn artwork.",
      "properties": {
        "units": {
          "const": "mm"
        },
        "enclosure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {
              "$ref": "#/$defs/millimeters"
            },
            "height": {
              "$ref": "#/$defs/millimeters"
            },
            "depth": {
              "$ref": "#/$defs/millimeters"
            },
            "cornerRadius": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "branding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "product": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "modelCode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        "mounting": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type"],
            "properties": {
              "id": {
                "$ref": "#/$defs/portId"
              },
              "type": {
                "enum": ["din-rail-35", "panel-cutout", "surface-screw"]
              },
              "fasteners": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              }
            }
          }
        },
        "strips": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "edge", "pitch"],
            "properties": {
              "id": {
                "$ref": "#/$defs/portId"
              },
              "edge": {
                "enum": ["top", "bottom", "left", "right"]
              },
              "pitch": {
                "$ref": "#/$defs/millimeters"
              }
            }
          }
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "lines"],
          "description": "Character-oriented status display. Firmware (for example a Wasm logic module) owns the bound values at runtime; the compiler only reserves the region and emits data anchors.",
          "properties": {
            "id": {
              "$ref": "#/$defs/portId"
            },
            "technology": {
              "enum": ["lcd", "oled"]
            },
            "lines": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "role"],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/portId"
                  },
                  "role": {
                    "enum": ["title", "value", "status"]
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "binds": {
                    "$ref": "#/$defs/bindReference"
                  },
                  "showUnit": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "indicators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "kind"],
            "properties": {
              "id": {
                "$ref": "#/$defs/portId"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "kind": {
                "enum": ["led", "rotor"]
              },
              "color": {
                "enum": ["green", "blue", "amber", "red", "white"]
              },
              "binds": {
                "$ref": "#/$defs/bindReference"
              }
            }
          }
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "kind", "action"],
            "properties": {
              "id": {
                "$ref": "#/$defs/portId"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "kind": {
                "const": "button"
              },
              "action": {
                "enum": ["identify", "custom"]
              }
            }
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "dataType"],
      "properties": {
        "id": {
          "$ref": "#/$defs/portId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dataType": {
          "enum": ["number", "boolean", "integer"]
        },
        "unit": {
          "type": "string",
          "maxLength": 64
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "default": {
          "type": ["number", "boolean"]
        },
        "retained": {
          "type": "boolean"
        }
      }
    }
  }
}
