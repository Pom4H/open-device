{
  "modelVersion": "0.1",
  "capabilities": ["sense", "control"],
  "ports": [
    {
      "id": "power-supply",
      "title": "Supply 24 V DC",
      "direction": "input",
      "domain": "power",
      "physical": {
        "medium": "electrical",
        "kind": "supply-dc",
        "range": "18-30 V DC, 3 W max"
      },
      "terminals": [
        { "label": "L+", "strip": "main", "index": 0 },
        { "label": "M", "strip": "main", "index": 1 }
      ]
    },
    {
      "id": "fieldbus",
      "title": "RS-485 fieldbus",
      "direction": "bidirectional",
      "domain": "network",
      "physical": {
        "medium": "electrical",
        "kind": "rs-485",
        "range": "Modbus RTU, up to 115200 Bd"
      },
      "terminals": [
        { "label": "A", "strip": "main", "index": 2 },
        { "label": "B", "strip": "main", "index": 3 }
      ]
    },
    {
      "id": "pressure",
      "title": "Pressure input",
      "direction": "input",
      "domain": "signal",
      "signal": {
        "dataType": "number",
        "unit": "bar",
        "minimum": 0,
        "maximum": 10
      },
      "physical": {
        "medium": "electrical",
        "kind": "analog-current",
        "range": "4-20 mA"
      },
      "terminals": [{ "label": "AI1", "strip": "main", "index": 4 }]
    },
    {
      "id": "auto-mode",
      "title": "Automatic mode permission",
      "direction": "input",
      "domain": "signal",
      "signal": {
        "dataType": "boolean"
      },
      "terminals": [{ "label": "DI1", "strip": "main", "index": 5 }]
    },
    {
      "id": "emergency-stop",
      "title": "Emergency stop",
      "direction": "input",
      "domain": "signal",
      "signal": {
        "dataType": "boolean"
      },
      "physical": {
        "medium": "electrical",
        "kind": "digital-input"
      },
      "terminals": [{ "label": "DI2", "strip": "main", "index": 6 }]
    },
    {
      "id": "pump-feedback",
      "title": "Pump running feedback",
      "direction": "input",
      "domain": "signal",
      "signal": {
        "dataType": "boolean"
      },
      "physical": {
        "medium": "electrical",
        "kind": "digital-input"
      },
      "terminals": [{ "label": "DI3", "strip": "main", "index": 7 }]
    },
    {
      "id": "pump-command",
      "title": "Pump command",
      "direction": "output",
      "domain": "signal",
      "signal": {
        "dataType": "boolean"
      },
      "physical": {
        "medium": "electrical",
        "kind": "digital-output"
      },
      "terminals": [{ "label": "DO1", "strip": "main", "index": 8 }]
    },
    {
      "id": "alarm",
      "title": "Alarm",
      "direction": "output",
      "domain": "signal",
      "signal": {
        "dataType": "boolean"
      },
      "terminals": [{ "label": "DO2", "strip": "main", "index": 9 }]
    }
  ],
  "faceplate": {
    "units": "mm",
    "enclosure": {
      "width": 200,
      "height": 150,
      "depth": 42,
      "cornerRadius": 10
    },
    "branding": {
      "product": "FLOW NODE",
      "modelCode": "PC-2040"
    },
    "mounting": [
      { "id": "panel", "type": "panel-cutout", "fasteners": 4 },
      { "id": "din", "type": "din-rail-35" }
    ],
    "strips": [{ "id": "main", "edge": "bottom", "pitch": 15 }],
    "display": {
      "id": "lcd",
      "technology": "lcd",
      "lines": [
        { "id": "product", "role": "title", "text": "FLOW NODE" },
        { "id": "pressure", "role": "value", "binds": "port:pressure", "showUnit": true },
        { "id": "status", "role": "status", "binds": "state:status" }
      ]
    },
    "indicators": [
      { "id": "pwr", "label": "PWR", "kind": "led", "color": "green", "binds": "state:power" },
      { "id": "net", "label": "NET", "kind": "led", "color": "blue", "binds": "state:link" },
      { "id": "io", "label": "I/O", "kind": "led", "color": "amber", "binds": "port:pump-command" },
      { "id": "rotor", "label": "PUMP", "kind": "rotor", "binds": "port:pump-command" }
    ],
    "controls": [{ "id": "identify", "label": "IDENTIFY", "kind": "button", "action": "identify" }]
  },
  "parameters": [
    {
      "id": "setpoint-low",
      "title": "Start pressure threshold",
      "dataType": "number",
      "unit": "bar",
      "minimum": 0,
      "maximum": 10,
      "default": 1.5,
      "retained": true
    },
    {
      "id": "setpoint-high",
      "title": "Stop pressure threshold",
      "dataType": "number",
      "unit": "bar",
      "minimum": 0,
      "maximum": 10,
      "default": 3,
      "retained": true
    },
    {
      "id": "start-delay-ms",
      "title": "Pump start delay",
      "dataType": "number",
      "unit": "ms",
      "minimum": 0,
      "default": 2000,
      "retained": true
    },
    {
      "id": "feedback-timeout-ms",
      "title": "Feedback alarm timeout",
      "dataType": "number",
      "unit": "ms",
      "minimum": 0,
      "default": 3000,
      "retained": true
    }
  ]
}
