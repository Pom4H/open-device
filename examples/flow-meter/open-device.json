{
  "$schema": "https://raw.githubusercontent.com/Pom4H/open-device/main/packages/spec/schemas/open-device-package.schema.json",
  "manifestVersion": "0.1",
  "id": "https://devices.open-device.dev/reference/flow-meter",
  "version": "0.1.0",
  "kind": "physical-device",
  "name": "flow-meter",
  "title": "Electromagnetic flow meter",
  "description": "Reference electromagnetic flow meter with a 4-20 mA rate output and a pulse totalizer output.",
  "vendor": {
    "name": "Open Device Reference",
    "url": "https://devices.open-device.dev"
  },
  "license": "Apache-2.0",
  "model": {
    "href": "./model/device-model.json",
    "mediaType": "application/json"
  },
  "views": [
    {
      "id": "front-panel",
      "role": "front-panel",
      "entrypoint": {
        "href": "./views/device.svg",
        "mediaType": "image/svg+xml"
      }
    }
  ],
  "extensions": {
    "https://open-device.dev/extensions/topology-node": {
      "view": "front-panel",
      "width": 240,
      "height": 210,
      "ports": {
        "flow": { "x": 240, "y": 52, "side": "right", "signal": "analog" },
        "pulse": { "x": 240, "y": 82, "side": "right", "signal": "digital" },
        "process-in": { "x": 0, "y": 160, "side": "left", "signal": "process" },
        "process-out": { "x": 240, "y": 160, "side": "right", "signal": "process" }
      }
    }
  }
}
