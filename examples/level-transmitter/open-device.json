{
  "$schema": "https://raw.githubusercontent.com/Pom4H/open-device/main/packages/spec/schemas/open-device-package.schema.json",
  "manifestVersion": "0.1",
  "id": "https://devices.open-device.dev/reference/level-transmitter",
  "version": "0.1.0",
  "kind": "physical-device",
  "name": "level-transmitter",
  "title": "Hydrostatic level transmitter",
  "description": "Reference hydrostatic level transmitter with a submersible probe and a 4-20 mA level output.",
  "vendor": {
    "name": "Open Device Reference",
    "url": "https://devices.open-device.dev"
  },
  "license": "Apache-2.0",
  "model": {
    "href": "./model/device-model.json",
    "mediaType": "application/json"
  },
  "views": [
    {
      "id": "front-panel",
      "role": "front-panel",
      "entrypoint": {
        "href": "./views/device.svg",
        "mediaType": "image/svg+xml"
      }
    }
  ],
  "extensions": {
    "https://open-device.dev/extensions/topology-node": {
      "view": "front-panel",
      "width": 190,
      "height": 220,
      "ports": {
        "level": { "x": 190, "y": 46, "side": "right", "signal": "analog" },
        "process": { "x": 95, "y": 212, "side": "bottom", "signal": "process" }
      }
    }
  }
}
